# ABOUTME: Template of the local .env (never committed): LLM provider settings for the AI module
# ABOUTME: Copy to .env and fill in; owner of the AI configuration: Gian

# Server LLM: cli = Claude Code CLI in headless mode (your logged-in plan, for local use);
# api = Anthropic API with ANTHROPIC_API_KEY below; none = no server LLM (public hosting:
# visitors add their own key in the AI box, decision D43)
LUNARNAV_LLM_PROVIDER=cli
# Optional: model id (empty = the CLI default, or claude-opus-5-5 for the API)
LUNARNAV_LLM_MODEL=
# Optional: path of the claude executable when it is not on PATH (default: ~/.local/bin)
LUNARNAV_CLAUDE_BIN=
# Needed only when LUNARNAV_LLM_PROVIDER=api
ANTHROPIC_API_KEY=
