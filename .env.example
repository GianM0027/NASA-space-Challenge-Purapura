# ABOUTME: Template of the local .env (never committed): LLM provider settings for the AI module
# ABOUTME: Copy to .env and fill in; owner of the AI configuration: Gian

# cli = Claude Code CLI in headless mode (uses your logged-in plan); api = Anthropic API
LUNARNAV_LLM_PROVIDER=cli
# Optional: model passed to the CLI (empty = the CLI default)
LUNARNAV_LLM_MODEL=
# Optional: path of the claude executable when it is not on PATH (default: ~/.local/bin)
LUNARNAV_CLAUDE_BIN=
# Needed only when LUNARNAV_LLM_PROVIDER=api (not implemented yet)
ANTHROPIC_API_KEY=
