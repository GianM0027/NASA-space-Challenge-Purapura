# ABOUTME: Template of the local .env (never committed): LLM provider settings for the AI module
# ABOUTME: Copy to .env and fill in; owner of the AI configuration: Gian

# Server LLM: cli = Claude Code CLI in headless mode (your logged-in plan, for local use);
# api = Anthropic API with ANTHROPIC_API_KEY below; none = no server LLM (public hosting:
# visitors add their own key in the AI box, decision D43)
LUNARNAV_LLM_PROVIDER=cli
# Optional: model id (empty = the CLI default, or claude-opus-5-5 for the API)
LUNARNAV_LLM_MODEL=
# Optional: path of the claude executable when it is not on PATH (default: ~/.local/bin)
LUNARNAV_CLAUDE_BIN=
# Needed only when LUNARNAV_LLM_PROVIDER=api
ANTHROPIC_API_KEY=
# Requests per client per minute (decision D44): empty = defaults (default=300, heavy=40, ai=20,
# write=30), "off" = no limits, or overrides such as "heavy=20,ai=10"
LUNARNAV_RATE_LIMITS=
# Accounts (decision D45): folder of the account database (default data/state) and the
# comma-separated usernames that may review site proposals
LUNARNAV_STATE_DIR=
LUNARNAV_ADMIN_USERS=
# "Update the site" in the admin panel (decision D46): folder shared with the server's deploy
# service (empty = feature off) and the GitHub repository whose main is deployed
LUNARNAV_CONTROL_DIR=
LUNARNAV_GITHUB_REPO=GianM0027/NASA-space-Challenge-Purapura
